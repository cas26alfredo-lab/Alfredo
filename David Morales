<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>YouTube - Broadcast Yourself (2006)</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #eeeeee;
            margin: 0;
            padding: 0;
            color: #333333;
        }
        /* Cabecera clásica de YouTube 2006 */
        header {
            background: linear-gradient(to bottom, #d6d6d6, #b5b5b5);
            border-bottom: 2px solid #666666;
            padding: 10px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .logo-area {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .logo-box {
            background-color: #cc0000;
            color: white;
            font-weight: bold;
            font-family: Impact, sans-serif;
            font-size: 26px;
            padding: 2px 8px;
            letter-spacing: -1px;
            border: 1px solid #990000;
            border-radius: 3px;
            cursor: pointer;
        }
        .logo-box span {
            color: #ffffff;
            background-color: #000000;
            padding: 0 4px;
            margin-left: 2px;
            border-radius: 2px;
        }
        nav a {
            color: #0033cc;
            text-decoration: none;
            font-size: 12px;
            font-weight: bold;
            margin-left: 15px;
            cursor: pointer;
        }
        nav a:hover {
            text-decoration: underline;
        }
        /* Contenido Principal */
        .container {
            width: 850px;
            max-width: 95%;
            margin: 15px auto;
            background-color: #ffffff;
            border: 1px solid #cccccc;
            padding: 15px;
        }
        h2 {
            font-size: 16px;
            border-bottom: 1px solid #cc0000;
            padding-bottom: 5px;
            color: #cc0000;
            margin-top: 0;
        }
        /* Sección de Subida */
        .upload-section {
            background-color: #f9f9f9;
            border: 1px dashed #999999;
            padding: 12px;
            margin-bottom: 20px;
        }
        .upload-section input {
            width: 98%;
            padding: 6px;
            margin: 5px 0 10px 0;
            border: 1px solid #b5b5b5;
            font-size: 12px;
        }
        .upload-btn {
            background: linear-gradient(to bottom, #f8f8f8, #dcdcdc);
            border: 1px solid #999999;
            padding: 6px 18px;
            font-weight: bold;
            cursor: pointer;
            font-size: 12px;
            color: #333;
        }
        .upload-btn:hover {
            background: linear-gradient(to bottom, #eaeaea, #cccccc);
        }
        /* Rejilla de Videos */
        .video-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 15px;
        }
        .video-card {
            border: 1px solid #cccccc;
            background-color: #fcfcfc;
            padding: 8px;
            font-size: 11px;
        }
        .video-thumb {
            width: 100%;
            height: 140px;
            background-color: #000000;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 5px;
            overflow: hidden;
        }
        .video-thumb video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .video-title {
            color: #0033cc;
            font-weight: bold;
            margin-bottom: 3px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .video-meta {
            color: #666666;
            font-size: 10px;
        }
        .video-creator {
            color: #444444;
            font-weight: bold;
            margin-top: 2px;
        }
    </style>
</head>
<body>

    <!-- Cabecera YouTube 2006 -->
    <header>
        <div class="logo-area">
            <div class="logo-box" onclick="irInicio()">You<span>Tube</span></div>
            <span style="font-size: 11px; font-weight: bold; color: #444;">Broadcast Yourself™ (2006 Tribute)</span>
        </div>
        <nav>
            <a onclick="irInicio()">Inicio</a>
            <a onclick="enfocarSubida()">Subir Video</a>
            <a onclick="alert('Estás en la sección Explorar: aquí ves los videos retro.')">Explorar</a>
            <a onclick="alert('Mi Cuenta: David Alfredo - Servidor Activo.')">Mi Cuenta</a>
        </nav>
    </header>

    <div class="container">
        
        <!-- Formulario para subir videos de forma segura -->
        <h2 id="seccion-titulo">Subir un video a YouTube</h2>
        <div class="upload-section" id="form-subida">
            <label style="font-weight: bold; font-size: 11px;">Título del video:</label>
            <input type="text" id="videoTitleInput" placeholder="Ej: Mi video casero (2006)">
            
            <label style="font-weight: bold; font-size: 11px;">Selecciona tu video del almacenamiento:</label>
            <input type="file" id="videoFileInput" accept="video/*">
            
            <button class="upload-btn" onclick="uploadVideo()">Publicar Video</button>
        </div>

        <!-- Lista de Videos -->
        <h2>Videos Destacados de la Comunidad</h2>
        <div class="video-grid" id="videoContainer">
            
            <!-- Video del Conejito, la mariposa y la manzana por David Alfredo -->
            <div class="video-card">
                <div class="video-thumb">
                    <!-- Reproduce exactamente la escena clásica del conejito, la mariposa y la manzana -->
                    <video controls preload="metadata" src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4#t=25,35"></video>
                </div>
                <div class="video-title">El conejito, la mariposa y la manzana gigante</div>
                <div class="video-creator">Por: David Alfredo</div>
                <div class="video-meta">Hace 2 años | 3,450 reproducciones</div>
            </div>

            <!-- Video de los Tres Cerditos -->
            <div class="video-card">
                <div class="video-thumb">
                    <video controls preload="metadata" src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4"></video>
                </div>
                <div class="video-title">Cuento clásico: Los Tres Cerditos</div>
                <div class="video-creator">Por: David Alfredo</div>
                <div class="video-meta">Hace 2 años | 980 reproducciones</div>
            </div>

        </div>

    </div>

    <!-- Pie de página con aviso legal -->
    <footer style="margin-top: 30px; border-top: 1px solid #cccccc; padding: 15px; text-align: center; font-size: 10px; color: #666666; background-color: #f1f1f1;">
        <p style="margin: 3px 0;">
            <strong>YouTube 2006 Fan Project</strong> — Un proyecto tributo de demostración sin fines de lucro.
        </p>
        <p style="margin: 3px 0;">
            YouTube, el logotipo de YouTube y Google son marcas registradas propiedad de <strong>Google LLC / Alphabet Inc.</strong> 
            Este sitio web no está afiliado, respaldado ni patrocinado por Google. Todos los derechos pertenecen a sus respectivos dueños.
        </p>
        <p style="margin: 3px 0; color: #999999;">
            © 2006-2026 — Recreación histórica y preservación digital.
        </p>
    </footer>

    <script>
        function uploadVideo() {
            const titleInput = document.getElementById('videoTitleInput');
            const fileInput = document.getElementById('videoFileInput');
            const container = document.getElementById('videoContainer');

            if (titleInput.value.trim() === '') {
                alert('Por favor escribe un título para tu video.');
                return;
            }

            if (fileInput.files.length === 0) {
                alert('Por favor selecciona un archivo de video de tu almacenamiento.');
                return;
            }

            const title = titleInput.value;
            const videoFile = fileInput.files[0];
            const videoUrl = URL.createObjectURL(videoFile);
            
            const card = document.createElement('div');
            card.className = 'video-card';
            card.innerHTML = `
                <div class="video-thumb">
                    <video controls src="${videoUrl}"></video>
                </div>
                <div class="video-title">${title}</div>
                <div class="video-creator">Por: David Alfredo</div>
                <div class="video-meta">Hace un momento | 1 reproducción</div>
            `;

            container.prepend(card);

            titleInput.value = '';
            fileInput.value = '';
            alert('¡Tu video se ha publicado con éxito en tu YouTube 2006!');
        }

        function enfocarSubida() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
            document.getElementById('videoTitleInput').focus();
        }

        function irInicio() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>

</body>
</html>
